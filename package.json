{
    "name": "cyeditor",
    "version": "1.0.3",
    "private": false,
    "description": "CyEditor, A visual flow chart editor based on cytoscape.js",
    "main": "dist/cyeditor.umd.js",
    "jsdelivr": "dist/cytoscape.umd.min.js",
    "keywords": [
        "cyeditor",
        "flowchart",
        "flow chart",
        "flow editor",
        "process editor",
        "flow chart editor",
        "vue flow chart",
        "cytoscape editor",
        "javascript flow",
        "graph editor",
        "diagram"
    ],
    "scripts": {
        "serve": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
        "build": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --target lib --name cyeditor src/index.js",
        "build:app": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --mode production",
        "lint": "vue-cli-service lint --fix",
        "docs:dev": "vuepress dev docs",
        "docs:build": "vuepress build docs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "rm -rf cypress/videos/* cypress/screenshots/* && start-server-and-test serve http://localhost:8080 'cypress run'",
        "cy:open": "cypress open",
        "precommit": "lint-staged",
        "deploy": "./deploy.sh"
    },
    "husky": {
        "hooks": {
            "postcommit": "git update-index --again",
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "src/**/*": [
            "eslint --fix",
            "git add"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/demonray/cyeditor.git"
    },
    "bugs": {
        "url": "https://github.com/demonray/cyeditor/issues"
    },
    "author": "ryanlei <leiqirong@gmail.com>",
    "license": "ISC",
    "dependencies": {
        "@antv/x6": "^3.1.4",
        "@antv/x6-vue-shape": "^3.0.2",
        "@vue/composition-api": "^1.7.2",
        "jsoneditor": "^10.4.2",
        "tslib": "^2.8.1",
        "vue-json-viewer": "^2.2.22"
    },
    "devDependencies": {
        "@babel/core": "^7.12.3",
        "@babel/preset-env": "^7.12.1",
        "@vue/cli-plugin-babel": "^3.5.1",
        "@vue/cli-plugin-eslint": "^3.5.1",
        "@vue/cli-service": "^3.5.1",
        "@vue/eslint-config-standard": "^4.0.0",
        "@vue/test-utils": "^1.3.0",
        "babel-core": "^6.26.3",
        "babel-eslint": "^10.0.1",
        "cypress": "^13.6.3",
        "eslint": "^5.15.3",
        "eslint-plugin-vue": "^5.2.2",
        "execa": "^5.1.1",
        "jsdom": "^21.0.0",
        "openapi-typescript": "^7.10.1",
        "puppeteer": "^24.34.0",
        "start-server-and-test": "^2.1.3",
        "stylus": "^0.54.5",
        "stylus-loader": "^3.0.2",
        "vite": "^4.0.0",
        "vite-plugin-vue2": "^2.0.0",
        "vitest": "^0.34.0",
        "vue": "^2.6.10",
        "vue-template-compiler": "^2.6.14",
        "vuepress": "^1.0.2",
        "webpack": ">=4 < 4.29"
    }
}