            "hint": "源端口 ID"
          },
          {
            "model": "dst_port_id",
            "label": "Dst Port Id",
            "required": false,
            "type": "input",
            "inputType": "number",
            "hint": "目标端口 ID"
          },
          {
            "model": "latency",
            "label": "Latency",
            "required": false,
            "type": "input",
            "inputType": "number",
            "hint": "链路延迟（周期）"
          },
          {
            "model": "bandwidth",
            "label": "Bandwidth",
            "required": false,
            "type": "input",
            "inputType": "number",
            "hint": "链路带宽"
          },
          {
            "model": "packet_types",
            "label": "Packet Types",
            "required": false,
            "type": "array",
            "hint": "支持的包类型"
          }
        ]
      }
    ]
  },
  "port": {
